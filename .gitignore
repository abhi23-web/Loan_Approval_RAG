# Secrets — never commit real keys.
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data: regenerable from the source registry, and potentially large.
data/raw/
data/processed/
data/chroma/
data/metadata/

# Evaluation output is a build artefact; the golden dataset itself IS committed.
evaluation/experiment_results/*
!evaluation/experiment_results/.gitkeep

# Editors / OS
.idea/
.DS_Store

# VS Code: ignore personal state, but keep the four files that make the project
# runnable for anyone who clones it. These describe the project, not a person's
# preferences, so they belong in version control.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Test fixtures written under data/ so file:// sources stay inside the repo.
data/test_fixtures/
