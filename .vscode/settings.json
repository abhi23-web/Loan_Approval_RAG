{
  // Point VS Code at the project's virtualenv. This is the single most
  // important setting here: without it, VS Code uses your system Python, every
  // import shows a squiggle, and the debugger fails on the first line.
  // On Windows change this to: ".venv\\Scripts\\python.exe"
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Activate the venv automatically in every new integrated terminal, so you
  // never have to remember `source .venv/bin/activate`.
  "python.terminal.activateEnvironment": true,

  // Let the Testing sidebar discover the 86 tests. They are fully offline —
  // no Ollama, no keys, no network — so this panel works from a cold clone.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Imports like `from app.core.config import ...` resolve from the project
  // root. Without this, Pylance underlines every one of them in red even
  // though the code runs correctly.
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.typeCheckingMode": "basic",

  // Keep the noise down: these are generated, not authored.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/data": true
  },

  "[python]": {
    "editor.rulers": [100],
    "editor.formatOnSave": false
  },

  // The YAML files carry the real configuration. Schema-free, but at least
  // get the indentation right.
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}
