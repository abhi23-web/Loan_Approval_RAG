# Copy to .env and fill in.  .env is gitignored and must never be committed.
# Everything here is either a secret or a machine-specific endpoint; all
# behavioural configuration lives in config/settings.yaml instead.

# --- Groq (the LLM) -------------------------------------------------------
# REQUIRED for real answers. Free tier, no card needed.
#   1. https://console.groq.com/keys
#   2. Create a key (looks like gsk_...). Copy it now — it is shown once.
#   3. Paste it below.
# Ingestion does NOT need this key; embeddings run locally.
GROQ_API_KEY=gsk_replace_me

# --- LangSmith (tracing, monitoring, dataset evaluation) -------------------
# Optional. Without it everything runs the same, just untraced.
# Create a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_replace_me
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=home-loan-rag

# --- Other OpenAI-compatible providers (optional) -------------------------
# The system speaks the OpenAI /chat/completions format, so switching provider
# is two lines in config/settings.yaml plus the matching key here.
#   OpenRouter  base_url https://openrouter.ai/api/v1   (has free models)
#   LM Studio   base_url http://localhost:1234/v1       (local, no key)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Ollama (only if you set a provider back to "ollama") -----------------
OLLAMA_BASE_URL=http://localhost:11434

# --- Backend endpoint used by the Streamlit frontend ----------------------
HOME_LOAN_API_URL=http://localhost:8000

# --- Optional runtime overrides -------------------------------------------
# Any settings.yaml value can be overridden with the HLR__ prefix, using the
# double underscore as a path separator. Examples:
# HLR__RETRIEVAL__TOP_K=8
# HLR__LLM__MODEL=llama-3.1-8b-instant
# HLR__EMBEDDINGS__PROVIDER=deterministic
